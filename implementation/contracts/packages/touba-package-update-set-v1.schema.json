{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "touba-package-update-set-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packages"],
  "properties": {
    "schema_version": {"const": "touba-package-update-set-v1"},
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"anyOf": [
        {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"$ref": "#/$defs/text"}}},
        {"type": "object", "additionalProperties": false, "required": ["name", "version", "registry", "trust"], "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[a-z_][a-z0-9_-]*(\\.[a-z_][a-z0-9_-]*)+$"},
          "version": {"type": "string", "maxLength": 256, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
          "registry": {"$ref": "#/$defs/text"}, "trust": {"$ref": "#/$defs/text"}
        }}
      ]}
    }
  },
  "$defs": {"text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}
}
