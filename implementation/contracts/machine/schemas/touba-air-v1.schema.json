{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/machine/touba-air-v1.schema.json",
  "title": "touba-air-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["air_schema_version", "air_capability_profile", "air_json_profile", "module", "definitions", "execution_graphs", "trace_points"],
  "properties": {
    "air_schema_version": { "const": "touba-air-v1" },
    "air_capability_profile": { "const": "touba-air-capabilities-v1" },
    "air_json_profile": { "const": "touba-air-json-canonical-v1" },
    "module": { "$ref": "#/$defs/module" },
    "imports": { "type": "array", "items": { "type": "object" } },
    "budgets": { "type": "object" },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": { "$ref": "#/$defs/identifiedCollection" },
        "constants": { "$ref": "#/$defs/identifiedCollection" },
        "functions": { "$ref": "#/$defs/identifiedCollection" },
        "tools": { "$ref": "#/$defs/identifiedCollection" },
        "memories": { "$ref": "#/$defs/identifiedCollection" },
        "skills": { "$ref": "#/$defs/identifiedCollection" },
        "agents": { "$ref": "#/$defs/identifiedCollection" },
        "strategies": { "$ref": "#/$defs/identifiedCollection" },
        "triggers": { "$ref": "#/$defs/identifiedCollection" }
      }
    },
    "execution_graphs": { "type": "array", "items": { "$ref": "#/$defs/graph" } },
    "trace_points": { "type": "array", "items": { "$ref": "#/$defs/identified" } }
  },
  "$defs": {
    "identified": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } },
    "identifiedCollection": { "type": "array", "items": { "$ref": "#/$defs/identified" } },
    "module": { "type": "object", "required": ["id", "name", "source_ref"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "source_ref": { "type": "object" } } },
    "graph": { "type": "object", "required": ["id", "owner_ref", "entry_node_id", "nodes", "edges", "source_ref"], "properties": { "id": { "type": "string" }, "owner_ref": { "type": "string" }, "entry_node_id": { "type": "string" }, "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }, "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }, "expressions": { "type": "array", "items": { "$ref": "#/$defs/expression" } }, "failure_paths": { "type": "array", "items": { "$ref": "#/$defs/failurePath" } }, "failure_path_refs": { "type": "array", "items": { "type": "string" } }, "source_ref": { "type": "object" } } },
    "node": { "type": "object", "required": ["id", "kind", "source_ref"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["call_function", "call_tool", "call_skill", "call_agent", "bind", "human_approval", "user_interaction", "branch", "loop", "give", "stop", "fallback"] }, "source_ref": { "type": "object" } } },
    "edge": { "type": "object", "required": ["from_node_id", "to_node_id", "role"], "properties": { "from_node_id": { "type": "string" }, "to_node_id": { "type": "string" }, "role": { "enum": ["next", "true", "false", "loop_next", "loop_exit", "failure", "fallback"] } } },
    "expression": { "type": "object", "required": ["id", "kind", "source_ref"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["value_ref", "literal_text", "literal_boolean", "literal_int", "literal_float", "text_conversion", "field_access", "construct_record", "unary_op", "binary_op"] }, "source_ref": { "type": "object" } } },
    "failurePath": { "type": "object", "required": ["id", "scope_ref", "trigger_node_id", "mode", "failure_family", "target_node_id", "source_ref"], "properties": { "id": { "type": "string" }, "scope_ref": { "type": "string" }, "trigger_node_id": { "type": "string" }, "mode": { "enum": ["fallback", "stop"] }, "failure_family": { "enum": ["business", "authority", "provider", "handler"] }, "target_node_id": { "type": "string" }, "source_ref": { "type": "object" } } }
  }
}
