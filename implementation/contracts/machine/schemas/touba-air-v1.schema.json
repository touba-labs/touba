{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/machine/touba-air-v1.schema.json",
  "title": "touba-air-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "air_schema_version",
    "air_capability_profile",
    "air_json_profile",
    "module",
    "definitions",
    "execution_graphs",
    "trace_points"
  ],
  "properties": {
    "air_schema_version": {
      "const": "touba-air-v1"
    },
    "air_capability_profile": {
      "const": "touba-air-capabilities-v1"
    },
    "air_json_profile": {
      "const": "touba-air-json-canonical-v1"
    },
    "module": {
      "$ref": "#/$defs/module"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_run_ms": {
              "$ref": "#/$defs/runLimit"
            },
            "max_steps": {
              "$ref": "#/$defs/runLimit"
            },
            "max_tool_calls": {
              "$ref": "#/$defs/runLimit"
            },
            "max_agent_invocations": {
              "$ref": "#/$defs/runLimit"
            },
            "max_provider_calls": {
              "$ref": "#/$defs/runLimit"
            }
          }
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeDefinition"
          }
        },
        "constants": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "functions": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "tools": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "memories": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "skills": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "agents": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "strategies": {
          "$ref": "#/$defs/identifiedCollection"
        },
        "triggers": {
          "$ref": "#/$defs/identifiedCollection"
        }
      }
    },
    "execution_graphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      }
    },
    "trace_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identified"
      }
    }
  },
  "$defs": {
    "runLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source_ref"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_ref": {
          "type": "object"
        }
      }
    },
    "typeDefinition": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type_ref": { "type": "string", "minLength": 1 },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "format": { "const": "digits" },
                  "min_length": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "max_length": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "min": { "type": "number" },
                  "max": { "type": "number" }
                }
              },
              "default": {},
              "source_ref": { "type": "object" }
            }
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "source_ref"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z_][A-Za-z0-9_]*$"
              },
              "source_ref": {
                "type": "object"
              }
            }
          }
        }
      },
      "if": {
        "required": [
          "variants"
        ]
      },
      "then": {
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "maxItems": 0
          }
        }
      }
    },
    "identified": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identifiedCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identified"
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "object"
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "id",
        "owner_ref",
        "entry_node_id",
        "nodes",
        "edges",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "owner_ref": {
          "type": "string"
        },
        "entry_node_id": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "failure_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failurePath"
          }
        },
        "failure_path_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ref": {
          "type": "object"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "call_function",
            "call_tool",
            "call_skill",
            "call_strategy",
            "call_agent",
            "parallel_call",
            "bind",
            "human_approval",
            "user_interaction",
            "branch",
            "loop",
            "give",
            "stop",
            "fallback"
          ]
        },
        "source_ref": {
          "type": "object"
        },
        "approval_policy": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Trimmed identifier, at most 128 UTF-8 bytes; byte length is checked by the machine validator."
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2592000000
            },
            "exclude_signers": { "type": "string", "minLength": 1, "maxLength": 128 },
            "distinct_from": {
              "enum": [
                "initiator",
                "previous",
                "initiator_and_previous"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parallel_call"
              }
            }
          },
          "then": {
            "required": [
              "target_ref",
              "collection_ref",
              "item_binding",
              "max_concurrency",
              "max_items",
              "result_binding"
            ],
            "properties": {
              "target_ref": {
                "type": "string"
              },
              "collection_ref": {
                "type": "string"
              },
              "item_binding": {
                "type": "string",
                "pattern": "^value:"
              },
              "max_concurrency": {
                "type": "integer",
                "minimum": 1
              },
              "max_items": {
                "type": "integer",
                "minimum": 1
              },
              "result_binding": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "approval_policy"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "human_approval"
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "from_node_id",
        "to_node_id",
        "role"
      ],
      "properties": {
        "from_node_id": {
          "type": "string"
        },
        "to_node_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "next",
            "true",
            "false",
            "loop_next",
            "loop_exit",
            "failure",
            "fallback",
            "expired",
            "rejected"
          ]
        }
      }
    },
    "expression": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "value_ref",
            "literal_text",
            "enum_value",
            "optional_some",
            "optional_none",
            "optional_present",
            "optional_value",
            "literal_boolean",
            "literal_int",
            "literal_float",
            "text_conversion",
            "date_conversion",
            "field_access",
            "construct_record",
            "copy_record",
            "construct_list",
            "list_comprehension",
            "list_concat",
            "text_join",
            "unary_op",
            "binary_op"
          ]
        },
        "source_ref": {
          "type": "object"
        }
      }
    },
    "failurePath": {
      "type": "object",
      "required": [
        "id",
        "scope_ref",
        "trigger_node_id",
        "mode",
        "failure_family",
        "target_node_id",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope_ref": {
          "type": "string"
        },
        "trigger_node_id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "fallback",
            "stop"
          ]
        },
        "failure_family": {
          "enum": [
            "business",
            "authority",
            "provider",
            "handler"
          ]
        },
        "target_node_id": {
          "type": "string"
        },
        "source_ref": {
          "type": "object"
        }
      }
    }
  }
}
