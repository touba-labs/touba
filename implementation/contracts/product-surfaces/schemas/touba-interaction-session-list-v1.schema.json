{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-interaction-session-list-v1.schema.json",
  "title": "touba-interaction-session-list-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sessions"],
  "properties": {
    "schema_version": { "const": "touba-interaction-session-list-v1" },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "target_ref",
          "target_kind",
          "presentation",
          "title",
          "status",
          "last_run_status",
          "updated_at",
          "message_count",
          "operation_count",
          "active_operation"
        ],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "target_ref": { "type": "string", "minLength": 1 },
          "target_kind": { "enum": ["agent", "function", "skill", "strategy", "tool", "trigger"] },
          "presentation": { "enum": ["conversation", "workflow", "invocation", "event"] },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "running", "awaiting_human", "failed", "archived"] },
          "last_run_status": {
            "enum": [
              null,
              "queued",
              "running",
              "cancel_requested",
              "awaiting_human",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted"
            ]
          },
          "updated_at": { "type": "string", "minLength": 1 },
          "message_count": { "type": "integer" },
          "operation_count": { "type": "integer" },
          "active_operation": { "type": ["object", "null"] }
        }
      }
    }
  }
}
