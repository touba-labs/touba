{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-deployment-bundle-v0.1.schema.json",
  "title": "touba-deployment-bundle-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "created_at",
    "source_revision",
    "source_dirty",
    "protocols",
    "artifacts",
    "bundle_id",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": { "const": "touba-deployment-bundle-v0.1" },
    "profile": { "enum": ["dev", "prod"] },
    "created_at": { "type": "string" },
    "source_revision": { "type": "string" },
    "source_dirty": { "type": "boolean" },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["air", "manifest", "ownership", "supply_chain_lock", "trace"],
      "properties": {
        "air": { "type": "string" },
        "manifest": { "type": "string" },
        "ownership": { "type": "string" },
        "supply_chain_lock": { "type": "string" },
        "trace": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "size_bytes", "sha256", "content_base64"],
        "properties": {
          "path": { "type": "string" },
          "kind": {
            "enum": [
              "source",
              "air",
              "handler",
              "manifest",
              "supply_chain_lock",
              "ownership",
              "run_plan",
              "metadata"
            ]
          },
          "size_bytes": { "type": "integer" },
          "sha256": { "type": "string" },
          "content_base64": { "type": "string" }
        }
      }
    },
    "bundle_id": { "type": "string" },
    "bundle_sha256": { "type": "string" }
  }
}
