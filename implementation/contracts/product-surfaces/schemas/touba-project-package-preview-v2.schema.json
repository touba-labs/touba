{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-package-preview-v2.schema.json",
  "title": "touba-project-package-preview-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "archive_digest",
    "expires_at",
    "name",
    "version",
    "packages",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "touba-project-package-preview-v2"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "archive_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "const": "source_contracts"
    },
    "operation": {
      "enum": [
        "install",
        "update"
      ]
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "previous",
          "version",
          "direction"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "previous": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "upgrade",
              "downgrade",
              "add",
              "keep"
            ]
          }
        }
      }
    },
    "dependency_changes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "before",
          "after"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/selectedPackage"
              }
            ]
          },
          "after": {
            "$ref": "#/$defs/selectedPackage"
          }
        }
      }
    },
    "dependency_constraints": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer",
          "dependency",
          "constraint",
          "version"
        ],
        "properties": {
          "blocking": { "type": "boolean" },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "dependency": {
            "type": "string",
            "minLength": 1
          },
          "constraint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contract_changes": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "tool",
          "before",
          "after"
        ],
        "properties": {
          "package": {
            "type": "string",
            "maxLength": 180
          },
          "tool": {
            "type": "string",
            "maxLength": 512
          },
          "before": {
            "type": [
              "object",
              "null"
            ],
            "maxProperties": 32
          },
          "after": {
            "type": [
              "object",
              "null"
            ],
            "maxProperties": 32
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tools",
          "handlers"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "tools": {
            "type": "object",
            "maxProperties": 4096
          },
          "handlers": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool",
                "entrypoint"
              ],
              "properties": {
                "tool": {
                  "type": "string"
                },
                "entrypoint": {
                  "type": "string"
                },
                "recommended_effect": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "selectedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
