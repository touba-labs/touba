{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-identity-directory-v1.schema.json",
  "title": "touba-identity-directory-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization", "members", "roles"],
  "properties": {
    "schema_version": { "const": "touba-identity-directory-v1" },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "status": { "enum": ["active", "disabled"] }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role_id", "status", "created_at", "user"],
        "properties": {
          "id": { "type": "string" },
          "role_id": { "type": "string" },
          "status": { "enum": ["active", "suspended"] },
          "created_at": { "type": "string" },
          "user": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "email", "display_name", "status", "created_at"],
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" },
              "display_name": { "type": "string" },
              "status": { "enum": ["active", "disabled"] },
              "created_at": { "type": "string" }
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "builtin", "permissions"],
        "properties": {
          "id": { "type": "string" },
          "organization_id": { "type": "string" },
          "name": { "type": "string" },
          "builtin": { "type": "boolean" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "created_at": { "type": "string" }
        }
      }
    }
  }
}
