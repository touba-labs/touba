{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-element-source-v1.schema.json",
  "title": "touba-element-source-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "element_ref", "module_ref", "kind", "name", "path", "content", "base_digest"],
  "properties": {
    "schema_version": { "const": "touba-element-source-v1" },
    "element_ref": { "type": "string" }, "module_ref": { "type": "string" },
    "kind": { "enum": ["module", "type", "enum", "memory", "function", "tool", "skill", "agent", "strategy", "trigger"] },
    "name": { "type": "string" }, "path": { "type": "string" },
    "content": { "type": "string", "maxLength": 65536 },
    "base_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
