{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-change-detail-v0.1.schema.json",
  "title": "touba-project-change-detail-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "change"],
  "properties": {
    "schema_version": { "const": "touba-project-change-detail-v0.1" },
    "generated_at": { "type": "string" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "status",
        "action",
        "target",
        "requested_by",
        "proposed_at",
        "proposal_reason",
        "content_sha256",
        "decided_at",
        "decided_by",
        "decision_reason",
        "validations",
        "evidence"
      ],
      "properties": {
        "proposal_id": { "type": "string" },
        "status": { "enum": ["pending", "applied", "refused"] },
        "action": { "enum": ["write_text_file"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string" }
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "content_sha256"],
            "properties": {
              "path": { "type": "string" },
              "role": { "type": "string" },
              "content_sha256": { "type": "string" }
            }
          }
        },
        "target_count": { "type": "integer" },
        "requested_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string" },
            "id": { "type": "string" }
          }
        },
        "proposed_at": { "type": "string" },
        "proposal_reason": { "type": "string" },
        "content_sha256": { "type": "string" },
        "decided_at": { "type": ["string", "null"] },
        "decided_by": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string" },
            "id": { "type": "string" }
          }
        },
        "decision_reason": { "type": ["string", "null"] },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "code", "message"],
            "properties": {
              "severity": { "enum": ["info", "warning", "error"] },
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "evidence": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["write_mode", "project_root", "relative_path"],
          "properties": {
            "write_mode": { "enum": ["atomic_rename", "recoverable_transaction", "none"] },
            "project_root": { "type": "string" },
            "relative_path": { "type": "string" },
            "relative_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "transaction_id": { "type": "string" }
          }
        }
      }
    }
  }
}
