{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-package-removal-v1.schema.json",
  "title": "touba-project-package-removal-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "package_digest", "name", "version", "expires_at"],
  "properties": {
    "schema_version": { "const": "touba-project-package-removal-v1" },
    "id": { "type": "string", "format": "uuid" },
    "revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "package_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
