{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-authority-graph-v0.1.schema.json",
  "title": "touba-authority-graph-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "project_root", "summary", "nodes", "edges", "diagnostics"],
  "properties": {
    "schema_version": { "const": "touba-authority-graph-v0.1" },
    "generated_at": { "type": "string" },
    "project_root": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_count", "edge_count", "diagnostic_count"],
      "properties": {
        "node_count": { "type": "integer" },
        "edge_count": { "type": "integer" },
        "diagnostic_count": { "type": "integer" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "ref", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["agent", "skill", "tool", "strategy", "trigger", "human_gate", "memory", "capability", "package", "module"] },
          "label": { "type": "string" },
          "ref": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "from", "to", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["uses", "callable_by", "requires", "grants", "imports", "dispatches"] },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "source_ref"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "source_ref": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "source_ref"],
      "properties": {
        "source": { "enum": ["source", "air", "manifest", "package", "trace", "project"] },
        "path": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] }
      }
    }
  }
}
