{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-trigger-queue-health-v1.schema.json",
  "title": "touba-trigger-queue-health-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "project_root", "summary", "triggers", "diagnostics"],
  "properties": {
    "schema_version": { "const": "touba-trigger-queue-health-v1" },
    "generated_at": { "type": "string" },
    "project_root": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_count", "healthy", "watch", "blocked", "pending", "processing", "retry", "dead_letter", "replay_rejected", "rate_limited"],
      "properties": {
        "trigger_count": { "type": "integer" },
        "healthy": { "type": "integer" },
        "watch": { "type": "integer" },
        "blocked": { "type": "integer" },
        "pending": { "type": "integer" },
        "processing": { "type": "integer" },
        "retry": { "type": "integer" },
        "dead_letter": { "type": "integer" },
        "replay_rejected": { "type": "integer" },
        "rate_limited": { "type": "integer" }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger_ref",
          "kind",
          "status",
          "transport_status",
          "pending",
          "processing",
          "retry",
          "dead_letter",
          "replay_rejected",
          "rate_limited",
          "refused",
          "last_event_id",
          "evidence"
        ],
        "properties": {
          "trigger_ref": { "type": "string" },
          "kind": { "enum": ["schedule", "request"] },
          "status": { "enum": ["healthy", "watch", "blocked"] },
          "transport_status": { "enum": ["enabled", "disabled", "paused", "blocked"] },
          "pending": { "type": "integer" },
          "processing": { "type": "integer" },
          "retry": { "type": "integer" },
          "dead_letter": { "type": "integer" },
          "replay_rejected": { "type": "integer" },
          "rate_limited": { "type": "integer" },
          "refused": { "type": "integer" },
          "last_event_id": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "event_id", "message"],
              "properties": {
                "source": { "type": "string" },
                "event_id": { "type": ["string", "null"] },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
