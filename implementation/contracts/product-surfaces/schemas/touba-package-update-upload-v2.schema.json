{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "touba-package-update-upload-v2",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "archives", "registry"],
  "properties": {
    "schema_version": { "const": "touba-package-update-upload-v2" },
    "archives": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 4, "maxLength": 89478488 } },
    "registry": {
      "type": "object", "additionalProperties": false, "required": ["index_jwt", "entries"],
      "properties": {
        "index_jwt": { "type": "string", "minLength": 1, "maxLength": 8388608 },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "version", "metadata"],
            "properties": {
              "name": { "type": "string", "minLength": 3, "maxLength": 180 },
              "version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "metadata": { "type": "string", "minLength": 2, "maxLength": 1048576 }
            }
          }
        }
      }
    }
  },
  "description": "One configured registry and a shared signed index. Entries correspond to archives by position. At most 64 MiB decoded archives, 8 MiB index and 1 MiB entries in aggregate. Core verifies signatures, identities, status, digests and local trust before review and again before application. No credentials or browser-selected origin."
}
