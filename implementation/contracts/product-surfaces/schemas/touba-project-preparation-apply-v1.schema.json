{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-preparation-apply-v1.schema.json",
  "title": "touba-project-preparation-apply-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "review_digest"],
  "properties": {
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "schema_version": { "const": "touba-project-preparation-apply-v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "review_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
