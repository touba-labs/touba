{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-interaction-operation-v0.1.schema.json",
  "title": "touba-interaction-operation-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "session_id",
    "message_id",
    "target_ref",
    "run_id",
    "status",
    "event_count",
    "current_event",
    "recent_events",
    "created_at",
    "started_at",
    "completed_at",
    "cancel_requested_at",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "touba-interaction-operation-v0.1" },
    "operation_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "minLength": 1 },
    "target_ref": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "awaiting_human",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "event_count": { "type": "integer", "minimum": 0 },
    "current_event": {
      "type": ["object", "null"]
    },
    "recent_events": {
      "type": "array",
      "items": { "type": "object" }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "started_at": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"] },
    "cancel_requested_at": { "type": ["string", "null"] },
    "error": {
      "type": ["object", "null"]
    }
  }
}
