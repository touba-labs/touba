{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-interaction-session-v0.2.schema.json",
  "title": "touba-interaction-session-v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "target_ref",
    "target_kind",
    "presentation",
    "effect_policy",
    "title",
    "status",
    "last_run_status",
    "created_at",
    "updated_at",
    "created_by",
    "messages",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": "touba-interaction-session-v0.2" },
    "session_id": { "type": "string", "minLength": 1 },
    "target_ref": { "type": "string", "minLength": 1 },
    "target_kind": { "enum": ["agent", "function", "skill", "strategy", "tool", "trigger"] },
    "presentation": { "enum": ["conversation", "workflow", "invocation", "event"] },
    "effect_policy": { "enum": ["runtime_only", "allow_declared_external_effects"] },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "running", "awaiting_human", "failed", "archived"] },
    "last_run_status": {
      "enum": [
        null,
        "queued",
        "running",
        "cancel_requested",
        "awaiting_human",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["studio", "ide", "cli", "user", "service"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "role",
          "created_at",
          "display_text",
          "operation_id",
          "run_id",
          "run_status"
        ],
        "properties": {
          "message_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["user", "touba"] },
          "created_at": { "type": "string", "minLength": 1 },
          "display_text": { "type": "string" },
          "operation_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": ["string", "null"] },
          "run_status": {
            "enum": [
              "queued",
              "running",
              "success",
              "failure",
              "stopped",
              "cancelled",
              "interrupted"
            ]
          },
          "run_result": {}
        }
      }
    },
    "operations": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
