{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-inspection-v1.schema.json",
  "title": "touba-project-inspection-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "project", "artifacts", "entrypoints", "diagnostics"],
  "properties": {
    "schema_version": { "const": "touba-project-inspection-v1" },
    "generated_at": { "type": "string" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "name", "host_language"],
      "properties": {
        "root": { "type": "string" },
        "name": { "type": "string" },
        "host_language": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "status"],
        "properties": {
          "kind": { "enum": ["source", "air", "manifest", "lock", "trace", "report"] },
          "path": { "type": "string" },
          "status": { "enum": ["present", "missing", "stale", "invalid"] }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "description", "input_contract"],
        "properties": {
          "kind": { "enum": ["agent", "function", "skill", "strategy", "tool", "trigger"] },
          "ref": { "type": "string" },
          "description": { "type": "string" },
          "input_contract": { "$ref": "#/$defs/inputContract" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_ref", "name", "version", "status", "digest", "path", "description", "documentation_url", "exports"],
        "properties": {
          "package_ref": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "status": { "const": "installed" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "documentation_url": { "type": "string" },
          "exports": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "source_ref": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type_ref", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type_ref": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "inputType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "name", "fields"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputField" }
        }
      }
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fields", "types"],
      "properties": {
        "mode": { "enum": ["declared", "open", "none", "unavailable"] },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputField" }
        },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputType" }
        }
      }
    }
  }
}
