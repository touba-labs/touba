{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-inspection-v1.schema.json",
  "title": "touba-project-inspection-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "artifacts",
    "entrypoints",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "touba-project-inspection-v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "name",
        "host_language"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "host_language": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "status"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "air",
              "manifest",
              "lock",
              "trace",
              "report"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "present",
              "missing",
              "stale",
              "invalid"
            ]
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "description",
          "effect_policy_requirement",
          "input_contract",
          "interaction_contract"
        ],
        "properties": {
          "kind": {
            "enum": [
              "agent",
              "function",
              "skill",
              "strategy",
              "tool",
              "trigger"
            ]
          },
          "ref": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "effect_policy_requirement": {
            "enum": [
              "runtime_only_compatible",
              "declared_external_effects_required",
              "unknown"
            ]
          },
          "input_contract": {
            "$ref": "#/$defs/inputContract"
          },
          "interaction_contract": {
            "$ref": "#/$defs/interactionContract"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_ref",
          "name",
          "version",
          "status",
          "digest",
          "path",
          "description",
          "documentation_url",
          "exports"
        ],
        "properties": {
          "package_ref": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "installed"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "documentation_url": {
            "type": "string"
          },
          "exports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type_ref",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type_ref": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "digits"
              ]
            },
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "inputType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "name",
        "fields"
      ],
      "properties": {
        "enum_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputField"
          }
        }
      }
    },
    "interactionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation",
        "primary_input_path",
        "context_paths",
        "accepted_content_kinds",
        "media_fields"
      ],
      "properties": {
        "presentation": {
          "enum": [
            "conversation",
            "workflow",
            "invocation",
            "event"
          ]
        },
        "primary_input_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "accepted_content_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "document",
              "file"
            ]
          }
        },
        "media_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content_kind",
              "type_ref",
              "multiple"
            ],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "content_kind": {
                "enum": [
                  "image",
                  "audio",
                  "document",
                  "file"
                ]
              },
              "type_ref": {
                "type": "string",
                "minLength": 1
              },
              "multiple": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "fields",
        "types"
      ],
      "properties": {
        "mode": {
          "enum": [
            "declared",
            "open",
            "none",
            "unavailable"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputField"
          }
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputType"
          }
        }
      }
    }
  }
}
