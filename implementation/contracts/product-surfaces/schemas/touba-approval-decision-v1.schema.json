{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-approval-decision-v1.schema.json",
  "title": "touba-approval-decision-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "trace_ref", "user_ref", "device_ref", "decision", "decided_by", "decided_at", "comment", "client_ref"],
  "properties": {
    "schema_version": { "const": "touba-approval-decision-v1" },
    "request_id": { "type": "string" },
    "run_id": { "type": "string" },
    "trace_ref": { "type": "string" },
    "user_ref": { "type": "string" },
    "device_ref": { "type": "string" },
    "decision": { "enum": ["approve", "reject", "request_review"] },
    "decided_by": { "type": "string" },
    "decided_at": { "type": "string" },
    "comment": { "type": ["string", "null"] },
    "client_ref": { "type": "string" }
  }
}
