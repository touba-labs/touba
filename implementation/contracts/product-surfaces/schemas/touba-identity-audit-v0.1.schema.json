{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-identity-audit-v0.1.schema.json",
  "title": "touba-identity-audit-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": { "const": "touba-identity-audit-v0.1" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "organization_id", "actor_user_id", "action", "target_ref", "metadata", "occurred_at"],
        "properties": {
          "id": { "type": "string" },
          "organization_id": { "type": "string" },
          "actor_user_id": { "type": ["string", "null"] },
          "action": { "type": "string" },
          "target_ref": { "type": "string" },
          "metadata": { "type": "object" },
          "occurred_at": { "type": "string" }
        }
      }
    }
  }
}
