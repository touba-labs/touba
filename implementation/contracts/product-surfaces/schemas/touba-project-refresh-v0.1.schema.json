{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-refresh-v0.1.schema.json",
  "title": "touba-project-refresh-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_root", "refreshed_at", "summary", "artifacts", "changes", "diagnostics"],
  "properties": {
    "schema_version": { "const": "touba-project-refresh-v0.1" },
    "status": { "enum": ["refreshed", "error"] },
    "project_root": { "type": "string" },
    "refreshed_at": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_count", "changed_count", "diagnostic_count"],
      "properties": {
        "artifact_count": { "type": "integer" },
        "changed_count": { "type": "integer" },
        "diagnostic_count": { "type": "integer" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "kind", "size_bytes", "mtime_ms", "sha256"],
        "properties": {
          "relative_path": { "type": "string" },
          "kind": { "enum": ["source", "air", "trace", "manifest", "lock", "project_config", "package", "ownership", "metadata"] },
          "size_bytes": { "type": "integer" },
          "mtime_ms": { "type": "integer" },
          "sha256": { "type": "string" }
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_artifacts"],
      "properties": {
        "changed_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "kind", "sha256"],
            "properties": {
              "relative_path": { "type": "string" },
              "kind": { "enum": ["source", "air", "trace", "manifest", "lock", "project_config", "package", "ownership", "metadata"] },
              "sha256": { "type": "string" }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
