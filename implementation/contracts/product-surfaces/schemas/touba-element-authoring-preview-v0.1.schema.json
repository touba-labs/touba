{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-element-authoring-preview-v0.1.schema.json",
  "title": "touba-element-authoring-preview-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "proposal_id", "element_ref", "preview_digest", "status", "changes", "validations", "impact"],
  "properties": {
    "schema_version": { "const": "touba-element-authoring-preview-v0.1" },
    "generated_at": { "type": "string" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "element_ref": { "type": "string", "minLength": 1 },
    "preview_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "const": "ready" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "operation", "current_sha256", "proposed_sha256", "diff"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["source", "manifest", "handler_stub", "project_file"] },
          "operation": { "enum": ["create", "update"] },
          "current_sha256": { "type": ["string", "null"] },
          "proposed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "diff": { "type": "string" }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "create_count", "update_count", "source_count", "metadata_count", "handler_stub_count"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 1 },
        "create_count": { "type": "integer", "minimum": 0 },
        "update_count": { "type": "integer", "minimum": 0 },
        "source_count": { "type": "integer", "minimum": 0 },
        "metadata_count": { "type": "integer", "minimum": 0 },
        "handler_stub_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
