{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-deployment-action-v1.schema.json",
  "title": "touba-deployment-action-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "actor"],
  "properties": {
    "schema_version": { "const": "touba-deployment-action-v1" },
    "action": { "enum": ["plan", "publish", "activate", "rollback"] },
    "profile": { "enum": ["dev", "prod"] },
    "revision_id": { "type": ["string", "null"] },
    "bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expected_state": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor": { "type": "string" }
  }
}
