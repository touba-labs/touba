{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-human-review-decision-v1.schema.json",
  "title": "touba-human-review-decision-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "trace_ref", "user_ref", "device_ref", "outcome", "reviewed_by", "reviewed_at", "comment", "client_ref"],
  "properties": {
    "schema_version": { "const": "touba-human-review-decision-v1" },
    "request_id": { "type": "string" },
    "run_id": { "type": "string" },
    "trace_ref": { "type": "string" },
    "user_ref": { "type": "string" },
    "device_ref": { "type": "string" },
    "outcome": { "enum": ["accepted", "changes_requested", "rejected", "escalated"] },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string" },
    "comment": { "type": ["string", "null"], "maxLength": 4096 },
    "client_ref": { "type": "string" }
  }
}
