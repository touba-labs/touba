{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-trace-timeline-v1.schema.json",
  "title": "touba-trace-timeline-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "trace_ref",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "touba-trace-timeline-v1"
    },
    "run_id": {
      "type": "string"
    },
    "trace_ref": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "type",
          "timestamp",
          "severity",
          "summary",
          "source_ref",
          "redaction"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "debug",
              "info",
              "warning",
              "error"
            ]
          },
          "summary": {
            "type": "string"
          },
          "invocation_id": { "type": "string", "maxLength": 512 },
          "span_id": { "type": "string", "maxLength": 512 },
          "parent_span_id": { "type": "string", "maxLength": 512 },
          "branch_id": { "type": "string", "maxLength": 512 },
          "source_location": {
            "type": "object", "additionalProperties": false, "required": ["source_id"],
            "properties": {
              "source_id": { "type": "string", "maxLength": 2048 },
              "start_byte": { "type": "integer", "minimum": 0 },
              "end_byte": { "type": "integer", "minimum": 0 },
              "start_line": { "type": "integer", "minimum": 0 },
              "end_line": { "type": "integer", "minimum": 0 },
              "start_column": { "type": "integer", "minimum": 0 },
              "end_column": { "type": "integer", "minimum": 0 }
            }
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "redaction": {
            "enum": [
              "none",
              "secrets_redacted",
              "payload_minimized"
            ]
          }
        }
      }
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "events_truncated": {
      "type": "boolean"
    }
  }
}
