{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-refresh-request-v1.schema.json",
  "title": "touba-project-refresh-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requested_by", "reason"],
  "properties": {
    "schema_version": { "const": "touba-project-refresh-request-v1" },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["cli", "studio", "ide", "user", "service"] },
        "id": { "type": "string" }
      }
    },
    "reason": { "type": "string" }
  }
}
