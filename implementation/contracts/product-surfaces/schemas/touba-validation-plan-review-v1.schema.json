{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-validation-plan-review-v1.schema.json",
  "title": "touba-validation-plan-review-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "path", "review_digest", "before", "after", "execution"],
  "properties": {
    "schema_version": {"const": "touba-validation-plan-review-v1"},
    "status": {"enum": ["preview", "written"]},
    "path": {"type": "string", "minLength": 1, "maxLength": 2048},
    "review_digest": {"$ref": "#/$defs/digest"},
    "before": {"$ref": "#/$defs/plan"},
    "after": {"$ref": "#/$defs/plan"},
    "execution": {"const": "none"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 2048},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "suites"],
      "properties": {
        "schema_version": {"const": "touba-validation-plan-v1"},
        "suites": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/suite"}}
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "kind", "engine", "tests", "inputs", "timeout_ms"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "kind": {"enum": ["contract", "business", "package"]},
        "engine": {"enum": ["node", "python", "package"]},
        "tests": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 120000},
        "env": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,100}$"}},
        "tool_refs": {"type": "array", "maxItems": 128, "items": {"type": "string", "pattern": "^tool:", "maxLength": 512}},
        "python": {
          "type": "object", "additionalProperties": false, "required": ["command", "digest"],
          "properties": {"command": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}}
        }
      }
    }
  }
}
