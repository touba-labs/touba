{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-human-decision-history-v1.schema.json",
  "title": "touba-human-decision-history-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "summary", "decisions"],
  "properties": {
    "schema_version": { "const": "touba-human-decision-history-v1" },
    "generated_at": { "type": "string" },
    "terminal_requests": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "pagination", "items"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pagination": { "$ref": "#/properties/pagination" },
        "items": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["request_id", "run_id", "target_ref", "outcome", "completed_at", "request_digest"],
          "properties": {
            "request_id": { "type": "string", "minLength": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "target_ref": { "type": "string", "minLength": 1 },
            "outcome": { "enum": ["expired", "cancelled"] },
            "completed_at": { "type": "string", "minLength": 1 },
            "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        } }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "cursor", "next_cursor", "order"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": ["string", "null"] },
        "next_cursor": { "type": ["string", "null"] },
        "order": { "const": "recorded_desc" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "approvals", "reviews"],
      "properties": {
        "total": { "type": "integer" },
        "approvals": { "type": "integer" },
        "reviews": { "type": "integer" }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_schema_version",
          "request_id",
          "run_id",
          "trace_ref",
          "user_ref",
          "device_ref",
          "decision_kind",
          "result",
          "decided_by",
          "decided_at",
          "comment",
          "client_ref",
          "accepted_at"
        ],
        "properties": {
          "source_schema_version": { "type": "string" },
          "request_id": { "type": "string" },
          "run_id": { "type": "string" },
          "trace_ref": { "type": "string" },
          "user_ref": { "type": "string" },
          "device_ref": { "type": "string" },
          "decision_kind": { "enum": ["approval", "human_review"] },
          "result": { "type": "string" },
          "decided_by": { "type": "string" },
          "decided_at": { "type": "string" },
          "comment": { "type": ["string", "null"] },
          "client_ref": { "type": "string" },
          "accepted_at": { "type": "string" }
        }
      }
    }
  }
}
