{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-change-history-v1.schema.json",
  "title": "touba-project-change-history-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "summary", "changes"],
  "properties": {
    "schema_version": { "const": "touba-project-change-history-v1" },
    "generated_at": { "type": "string" },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "cursor", "next_cursor", "order", "status"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{0,15}$" },
        "next_cursor": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{0,15}$" },
        "order": { "const": "recorded_desc" },
        "status": { "enum": ["all", "pending", "applied", "refused"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pending", "applied", "refused"],
      "properties": {
        "total": { "type": "integer" },
        "pending": { "type": "integer" },
        "applied": { "type": "integer" },
        "refused": { "type": "integer" }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "status",
          "action",
          "target",
          "requested_by",
          "proposed_at",
          "proposal_reason",
          "content_sha256",
          "decided_at",
          "decided_by",
          "decision_reason"
        ],
        "properties": {
          "proposal_id": { "type": "string" },
          "status": { "enum": ["pending", "applied", "refused"] },
          "action": { "enum": ["write_text_file"] },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string" }
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "content_sha256"],
              "properties": {
                "path": { "type": "string" },
                "role": { "type": "string" },
                "content_sha256": { "type": "string" }
              }
            }
          },
          "target_count": { "type": "integer" },
          "requested_by": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string" },
              "id": { "type": "string" }
            }
          },
          "proposed_at": { "type": "string" },
          "proposal_reason": { "type": "string" },
          "content_sha256": { "type": "string" },
          "decided_at": { "type": ["string", "null"] },
          "decided_by": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string" },
              "id": { "type": "string" }
            }
          },
          "decision_reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
