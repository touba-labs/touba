{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-interaction-session-list-v0.1.schema.json",
  "title": "touba-interaction-session-list-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sessions"],
  "properties": {
    "schema_version": { "const": "touba-interaction-session-list-v0.1" },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "target_ref", "target_kind", "presentation", "status", "updated_at", "message_count"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "target_ref": { "type": "string", "minLength": 1 },
          "target_kind": { "enum": ["agent", "function", "skill", "strategy", "tool", "trigger"] },
          "presentation": { "enum": ["conversation", "workflow", "invocation", "event"] },
          "status": { "enum": ["active", "awaiting_human", "completed", "failed"] },
          "updated_at": { "type": "string", "minLength": 1 },
          "message_count": { "type": "integer" }
        }
      }
    }
  }
}
