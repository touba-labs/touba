{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-mobile-quick-approval-policy-v1.schema.json",
  "title": "touba-mobile-quick-approval-policy-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "policy_ref", "status", "max_risk", "allowed_modes", "allowed_decisions", "require_biometric", "fallback_target", "evidence"],
  "properties": {
    "schema_version": { "const": "touba-mobile-quick-approval-policy-v1" },
    "generated_at": { "type": "string" },
    "policy_ref": { "type": "string" },
    "status": { "enum": ["enabled", "disabled"] },
    "max_risk": { "enum": ["low", "medium", "high"] },
    "allowed_modes": { "type": "array", "items": { "enum": ["approval", "human_review"] } },
    "allowed_decisions": { "type": "array", "items": { "type": "string" } },
    "require_biometric": { "type": "boolean" },
    "fallback_target": { "type": "string" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "message"],
      "properties": {
        "source": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
