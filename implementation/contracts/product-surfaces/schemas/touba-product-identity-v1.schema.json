{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-product-identity-v1.schema.json",
  "title": "touba-product-identity-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "summary", "users", "teams", "roles", "devices", "sessions", "assignments", "escalation_policies", "events"],
  "properties": {
    "schema_version": { "const": "touba-product-identity-v1" },
    "generated_at": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_count", "team_count", "device_count", "active_assignment_count", "revoked_device_count"],
      "properties": {
        "user_count": { "type": "integer" },
        "team_count": { "type": "integer" },
        "device_count": { "type": "integer" },
        "active_assignment_count": { "type": "integer" },
        "revoked_device_count": { "type": "integer" }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_ref", "display_name", "email", "status", "team_refs", "role_refs"],
        "properties": {
          "user_ref": { "type": "string" },
          "display_name": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "status": { "enum": ["active", "disabled"] },
          "team_refs": { "type": "array", "items": { "type": "string" } },
          "role_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["team_ref", "name", "owner_refs"],
        "properties": {
          "team_ref": { "type": "string" },
          "name": { "type": "string" },
          "owner_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_ref", "name", "scope"],
        "properties": {
          "role_ref": { "type": "string" },
          "name": { "type": "string" },
          "scope": { "type": "string" }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_ref", "user_ref", "kind", "status", "paired_at", "revoked_at"],
        "properties": {
          "device_ref": { "type": "string" },
          "user_ref": { "type": "string" },
          "kind": { "enum": ["mobile", "studio", "watch", "service"] },
          "status": { "enum": ["paired", "revoked", "expired"] },
          "paired_at": { "type": "string" },
          "revoked_at": { "type": ["string", "null"] }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_ref", "user_ref", "device_ref", "status", "started_at", "expires_at"],
        "properties": {
          "session_ref": { "type": "string" },
          "user_ref": { "type": "string" },
          "device_ref": { "type": "string" },
          "status": { "enum": ["active", "expired", "revoked"] },
          "started_at": { "type": "string" },
          "expires_at": { "type": "string" }
        }
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignment_ref", "request_id", "run_id", "trace_ref", "user_ref", "team_ref", "role_ref", "device_ref", "status", "assigned_at", "expires_at", "escalation_policy_ref"],
        "properties": {
          "assignment_ref": { "type": "string" },
          "request_id": { "type": "string" },
          "run_id": { "type": "string" },
          "trace_ref": { "type": "string" },
          "user_ref": { "type": "string" },
          "team_ref": { "type": "string" },
          "role_ref": { "type": "string" },
          "device_ref": { "type": "string" },
          "status": { "enum": ["assigned", "accepted", "declined", "expired", "escalated", "revoked"] },
          "assigned_at": { "type": "string" },
          "expires_at": { "type": "string" },
          "escalation_policy_ref": { "type": ["string", "null"] }
        }
      }
    },
    "escalation_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_ref", "name", "steps"],
        "properties": {
          "policy_ref": { "type": "string" },
          "name": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["after_ms", "reviewer_ref"],
              "properties": {
                "after_ms": { "type": "integer" },
                "reviewer_ref": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "type", "emitted_at", "user_ref", "device_ref", "request_id", "run_id", "trace_ref"],
        "properties": {
          "event_id": { "type": "string" },
          "type": { "enum": ["assignment.created", "notification.sent", "assignment.escalated", "decision.accepted", "device.revoked"] },
          "emitted_at": { "type": "string" },
          "user_ref": { "type": ["string", "null"] },
          "device_ref": { "type": ["string", "null"] },
          "request_id": { "type": ["string", "null"] },
          "run_id": { "type": ["string", "null"] },
          "trace_ref": { "type": ["string", "null"] }
        }
      }
    }
  }
}
