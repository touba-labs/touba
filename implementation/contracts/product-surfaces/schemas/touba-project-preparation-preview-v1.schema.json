{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-project-preparation-preview-v1.schema.json",
  "title": "touba-project-preparation-preview-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "review_digest", "expires_at", "can_apply", "status", "profile", "diagnostics", "actions", "changes"],
  "properties": {
    "schema_version": { "const": "touba-project-preparation-preview-v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "review_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "expires_at": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$" },
    "can_apply": { "type": "boolean" },
    "status": { "enum": ["success", "needs_changes", "error"] },
    "profile": { "const": "dev" },
    "diagnostics": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "severity"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "severity": { "enum": ["error", "warning", "info"] } }
    } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "changes": { "type": "array", "maxItems": 512, "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "subject", "field", "before", "after"],
      "properties": {
        "kind": { "enum": ["review_package_contract", "adopt_package_contract", "review_fragment_binding", "update_fragment_binding"] },
        "subject": { "type": "string", "maxLength": 512 }, "field": { "type": "string", "maxLength": 100 },
        "before": { "type": ["string", "null"], "maxLength": 16384 },
        "after": { "type": ["string", "null"], "maxLength": 16384 }
      }
    } }
  }
}
