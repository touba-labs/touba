{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-element-authoring-request-v1.schema.json",
  "title": "touba-element-authoring-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "module_ref", "element", "requested_by", "reason"],
  "properties": {
    "schema_version": { "const": "touba-element-authoring-request-v1" },
    "proposal_id": { "type": "string" },
    "module_ref": { "type": "string" },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "description"],
      "properties": {
        "kind": {
          "enum": ["module", "type", "enum", "memory", "function", "tool", "skill", "agent", "strategy", "trigger"]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "responsibility": { "type": "string", "minLength": 12 },
        "entrypoint": { "type": "boolean" },
        "fields": { "$ref": "#/properties/element/properties/takes" },
        "variants": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "string" } },
        "body": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "maxLength": 65536 } },
        "approval_policy": {
          "type": "object", "additionalProperties": false, "required": ["role", "timeout_ms"],
          "properties": {
            "role": { "type": "string", "minLength": 1, "maxLength": 128 },
            "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 2592000000 },
            "distinct_from": { "enum": ["initiator", "previous", "initiator_and_previous"] }
          }
        },
        "takes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type_ref"],
            "properties": {
              "name": { "type": "string" },
              "type_ref": { "type": "string" }
            }
          }
        },
        "gives": { "type": ["string", "null"] },
        "uses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "callable_by": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "access"],
            "properties": {
              "ref": { "type": "string" },
              "access": { "enum": ["read", "write"] }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "enum": [
              "network",
              "filesystem_read",
              "filesystem_write",
              "secret_read",
              "memory_read",
              "memory_write"
            ]
          }
        },
        "secrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "handler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect_contract"],
          "properties": {
            "effect_contract": {
              "type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": {
                "kind": { "enum": ["none", "external_write"] },
                "retry_mode": { "enum": ["none", "idempotency_key", "reconcile"] },
                "compensation": { "type": "object", "additionalProperties": false, "required": ["entry_ref"], "properties": { "entry_ref": { "type": "string", "minLength": 1 } } }
              }
            },
            "timeout_ms": { "type": "integer" },
            "max_payload_bytes": { "type": "integer" },
            "sandbox_required": { "type": "boolean" }
          }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_kind", "target_ref", "max_runs_per_day", "timeout_ms"],
          "properties": {
            "event_kind": { "enum": ["request", "schedule"] },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string" },
            "schedule": { "type": "string" },
            "target_ref": { "type": "string" },
            "payload_map": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "arguments": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "max_runs_per_day": { "type": "integer" },
            "timeout_ms": { "type": "integer" }
          }
        }
      }
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["studio", "user", "service"] },
        "id": { "type": "string" }
      }
    },
    "reason": { "type": "string" },
    "preview_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
