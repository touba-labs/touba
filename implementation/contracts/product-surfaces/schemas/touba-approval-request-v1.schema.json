{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-approval-request-v1.schema.json",
  "title": "touba-approval-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "mode", "requester_ref", "capability_ref", "reason", "summary", "allowed_decisions", "expires_at", "trace_ref", "redaction"],
  "properties": {
    "schema_version": { "const": "touba-approval-request-v1" },
    "request_id": { "type": "string" },
    "run_id": { "type": "string" },
    "mode": { "const": "approval" },
    "requester_ref": { "type": "string" },
    "capability_ref": { "type": "string" },
    "reason": { "type": "string" },
    "summary": { "type": "string" },
    "tool_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_ref", "caller_ref", "agent_ref", "policy_origin", "operation_digest", "arguments_digest", "prior_signers", "prior_signers_truncated"],
      "properties": {
        "tool_ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "caller_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "agent_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "policy_origin": { "enum": ["source", "consumer", "source_and_consumer"] },
        "operation_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "arguments_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "package": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "digest", "admission_id", "lock_digest", "manifest_digest"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 256 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "admission_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "lock_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
            "manifest_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "prior_signers": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["signer_ref", "accepted_at", "roles", "roles_truncated"],
            "properties": {
              "signer_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "accepted_at": { "type": "string", "maxLength": 32 },
              "roles": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
              "roles_truncated": { "type": "boolean" }
            }
          }
        },
        "prior_signers_truncated": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exclude_signers": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 2592000000 },
        "distinct_from": { "enum": ["initiator", "previous", "initiator_and_previous"] }
      }
    },
    "allowed_decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["approve", "reject", "request_review"] }
    },
    "expires_at": { "type": "string" },
    "trace_ref": { "type": "string" },
    "redaction": { "enum": ["none", "secrets_redacted", "payload_minimized"] }
  }
}
