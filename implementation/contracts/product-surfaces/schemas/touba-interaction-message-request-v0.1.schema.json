{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-interaction-message-request-v0.1.schema.json",
  "title": "touba-interaction-message-request-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "display_text", "inputs", "requested_by"],
  "properties": {
    "schema_version": { "const": "touba-interaction-message-request-v0.1" },
    "message_id": { "type": "string", "minLength": 1 },
    "display_text": { "type": "string" },
    "inputs": { "type": "object", "additionalProperties": true },
    "event_id": { "type": "string" },
    "source_kind": { "enum": ["schedule", "request"] },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["studio", "ide", "cli", "user", "service"] },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
