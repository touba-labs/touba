{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-benchmark-regression-v0.1.schema.json",
  "title": "touba-benchmark-regression-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "project_root", "summary", "runs", "groups", "regressions", "diagnostics"],
  "properties": {
    "schema_version": { "const": "touba-benchmark-regression-v0.1" },
    "generated_at": { "type": "string" },
    "project_root": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_count", "scenario_count", "group_a_governed", "group_b_governed", "regression_count", "source"],
      "properties": {
        "run_count": { "type": "integer" },
        "scenario_count": { "type": "integer" },
        "group_a_governed": { "type": "integer" },
        "group_b_governed": { "type": "integer" },
        "regression_count": { "type": "integer" },
        "source": { "type": "string" }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_ref", "label", "started_at", "model", "frameworks", "scenario_count", "evidence_ref"],
        "properties": {
          "run_ref": { "type": "string" },
          "label": { "type": "string" },
          "started_at": { "type": "string" },
          "model": { "type": "string" },
          "frameworks": { "type": "array", "items": { "type": "string" } },
          "scenario_count": { "type": "integer" },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_ref", "label", "scope", "scenario_count", "winner_refs", "notes"],
        "properties": {
          "group_ref": { "type": "string" },
          "label": { "type": "string" },
          "scope": { "enum": ["common_surface", "touba_specific"] },
          "scenario_count": { "type": "integer" },
          "winner_refs": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_ref", "framework_ref", "severity", "current_status", "previous_status", "evidence_ref", "message"],
        "properties": {
          "scenario_ref": { "type": "string" },
          "framework_ref": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "current_status": { "type": "string" },
          "previous_status": { "type": "string" },
          "evidence_ref": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
