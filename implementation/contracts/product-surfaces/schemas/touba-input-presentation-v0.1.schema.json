{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.touba.dev/product-surfaces/touba-input-presentation-v0.1.schema.json",
  "title": "touba-input-presentation-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": { "const": "touba-input-presentation-v0.1" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_ref", "generated_fields"],
        "properties": {
          "target_ref": { "type": "string", "minLength": 1 },
          "generated_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "generator"],
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "generator": { "enum": ["uuid", "timestamp", "prefixed_timestamp"] },
                "prefix": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
