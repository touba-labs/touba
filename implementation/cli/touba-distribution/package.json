{
  "name": "@touba/distribution",
  "version": "0.1.0",
  "private": true,
  "description": "Local Touba toolchain distribution packaging checks.",
  "type": "module",
  "scripts": {
    "package:local": "node src/package-local-toolchain.mjs",
    "check:local": "node src/check-local-toolchain.mjs",
    "install:local": "node src/install-local-toolchain.mjs",
    "check:install-local": "node src/check-local-install.mjs",
    "package:release": "node src/package-release.mjs",
    "check:release-archive": "node src/check-release-archive.mjs",
    "test:release-metadata": "node --test src/package-release.test.mjs",
    "test:sdk-archive": "node --test src/package-sdk.test.mjs",
    "package:release:macos": "node src/package-macos-release.mjs",
    "check:release:macos": "node src/check-macos-release.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
