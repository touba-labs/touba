; Inputs are generated by package-installers.mjs, never from a public URL.
[Setup]
AppId=Touba.User.Toolchain
AppName=Touba
AppVersion={#ToubaVersion}
AppPublisher=Touba Labs
DefaultDirName={userprofile}\.touba
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#OutputDir}
OutputBaseFilename={#OutputName}
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ChangesEnvironment=yes
UninstallDisplayName=Touba (user installation)
SetupLogging=yes
CloseApplications=no
RestartApplications=no
UsePreviousAppDir=no
InfoBeforeFile={#WelcomeFile}

[Tasks]
Name: "userpath"; Description: "Add Touba to PATH for new terminals"; Flags: checkedonce

[Files]
Source: "{#PayloadDir}\*"; DestDir: "{tmp}\touba-setup\payload"; Flags: recursesubdirs createallsubdirs deleteafterinstall
Source: "{#SupportDir}\*"; DestDir: "{tmp}\touba-setup\support"; Flags: recursesubdirs createallsubdirs deleteafterinstall

[UninstallDelete]
Type: files; Name: "{app}\bin\touba.cmd"
Type: files; Name: "{app}\INSTALLATION.json"
Type: filesandordirs; Name: "{app}\touba-toolchain"

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if DirExists(ExpandConstant('{userprofile}\.touba\touba-toolchain')) and not WizardSilent then
    Result := MsgBox('Touba is already installed. Stop its services before updating. The previous build is preserved; projects and their SDKs are not changed. Continue?', mbConfirmation, MB_YESNO) = IDYES;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ExitCode: Integer;
  Arguments, UserPath, Bin: String;
begin
  if CurStep = ssPostInstall then begin
    Arguments := '"' + ExpandConstant('{tmp}\touba-setup\support\src\desktop-install.mjs') + '" --source "' + ExpandConstant('{tmp}\touba-setup\payload') + '" --prefix "' + ExpandConstant('{app}') + '" --force';
    if not Exec(ExpandConstant('{tmp}\touba-setup\payload\bin\node.exe'), Arguments, '', SW_HIDE, ewWaitUntilTerminated, ExitCode) then
      RaiseException('Could not start the Touba installer. Your projects were not changed.');
    if ExitCode <> 0 then
      RaiseException('Touba installation or verification failed. Inspect the setup log and existing installation before retrying.');
    if WizardIsTaskSelected('userpath') then begin
      Bin := ExpandConstant('{app}\bin');
      RegQueryStringValue(HKCU, 'Environment', 'Path', UserPath);
      if Pos(';' + Lowercase(Bin) + ';', ';' + Lowercase(UserPath) + ';') = 0 then begin
        if (UserPath <> '') and (Copy(UserPath, Length(UserPath), 1) <> ';') then UserPath := UserPath + ';';
        if not RegWriteExpandStringValue(HKCU, 'Environment', 'Path', UserPath + Bin) then
          RaiseException('Touba is installed, but PATH could not be updated. Add its bin directory in Windows settings.');
      end;
    end;
  end;
end;

function InitializeUninstall(): Boolean;
var
  Metadata: AnsiString;
begin
  Result := LoadStringFromFile(ExpandConstant('{app}\INSTALLATION.json'), Metadata);
  if Result then Result := Pos('touba-desktop-install-v1', String(Metadata)) > 0;
  if not Result then MsgBox('This installation is no longer owned by this installer. Use the installation method that replaced it.', mbError, MB_OK);
  if Result and not UninstallSilent then
    Result := MsgBox('Stop Touba services before removal. The CLI will be removed; your projects, SDKs, saved builds and other data will be kept. Continue?', mbConfirmation, MB_YESNO) = IDYES;
end;
