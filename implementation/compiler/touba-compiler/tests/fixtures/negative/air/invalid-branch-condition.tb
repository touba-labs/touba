module invalid.branch

type AcceptedDraft
    body is Text

function IsAcceptable
    gives Boolean
    do
        give true

skill ReviewDraft
    gives AcceptedDraft
    uses IsAcceptable
    do
        if accepted
            give AcceptedDraft
        else
            stop

agent Reviewer
    uses ReviewDraft

strategy RunReview
    uses Reviewer
    do
        Reviewer
        give AcceptedDraft
