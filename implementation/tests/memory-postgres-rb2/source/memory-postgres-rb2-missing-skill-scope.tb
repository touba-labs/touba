module examples.memory_postgres_missing_skill_scope

memory CustomerMemory

type MemoryRequest
    customer_id is Text
    note is Text

type MemoryResult
    customer_id is Text
    stored_note is Text
    backend is Text

tool WriteCustomerMemory
    uses memory CustomerMemory write
    takes request as MemoryRequest
    gives MemoryResult
    requires network, secret_read, memory_write
    secrets POSTGRES_MEMORY_TOKEN

skill StoreCustomerMemory
    takes request as MemoryRequest
    gives MemoryResult
    uses WriteCustomerMemory
    do
        WriteCustomerMemory
            with request as request
            into stored

        give stored
