module examples.js_sdk_engine_project

type JsSdkEngineRequest
    name is Text

type JsSdkEngineResult
    message is Text
    secret_seen is Boolean

tool BuildGreeting
    takes request as JsSdkEngineRequest
    gives JsSdkEngineResult
    requires network, secret_read
    secrets DEMO_API_KEY

skill RunGreeting
    takes request as JsSdkEngineRequest
    gives JsSdkEngineResult
    uses BuildGreeting
    do
        BuildGreeting
            with request as request
            into result
        show
            with message as result.message
        give result
