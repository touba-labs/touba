module examples.agent_decision_provider_v1

type ResearchRequest
    query is Text

skill ListDatasets
    description "Lists datasets available for the governed research request."
    gives Text
    do
        show
            with message as "Dataset list selected"
        give "dataset-list"

skill BuildBrief
    description "Builds a concise brief from the declared research request."
    takes request as ResearchRequest
    gives Text
    do
        show
            with message as "Brief selected"
        give request.query

skill HiddenAdminPath
    description "Represents an undeclared administrative path used by refusal tests."
    gives Text
    do
        show
            with message as "Hidden path selected"
        give "hidden"

agent DonneesQuebecResearcher
    takes request as ResearchRequest
    gives Text
    description "Selects declared dataset research capabilities for one request."
    responsibility "Selects declared dataset research capabilities for one request."
    uses ListDatasets
    uses BuildBrief
    callable_by strategy RunResearch

strategy RunResearch
    takes request as ResearchRequest
    gives Text
    description "Runs one governed dataset research request."
    uses DonneesQuebecResearcher
    do
        DonneesQuebecResearcher
            with request as request
            into brief
        give brief
