{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "src/agent-provider-content.mjs",
    "src/air-runtime-profile.mjs",
    "src/handler-protocol.mjs",
    "src/human-approval-checkpoints.mjs",
    "src/payload-validation.mjs",
    "src/runtime-budgets.mjs",
    "src/runtime-errors.mjs",
    "src/runtime-options.mjs",
    "src/run-controls.mjs",
    "src/secret-redaction.mjs",
    "src/trace-builder.mjs"
  ]
}
