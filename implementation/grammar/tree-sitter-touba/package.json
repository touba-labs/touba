{
  "name": "tree-sitter-touba",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Tree-sitter grammar for the Touba language.",
  "tree-sitter": [
    {
      "scope": "source.touba",
      "file-types": [
        "tb"
      ]
    }
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "parse:examples": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/tb-v01-001-linear-skill.tb examples/tb-v01-002-fallback.tb examples/tb-v01-003-branch.tb examples/tb-v01-004-loop.tb examples/tb-v01-005-strategy-agents.tb",
    "parse:anneau1-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/anneau-1/positive/tb-a1-p01-tool-with-argument.tb examples/anneau-1/positive/tb-a1-p02-tool-result-binding.tb examples/anneau-1/positive/tb-a1-p03-skill-composition-binding.tb examples/anneau-1/positive/tb-a1-p04-branch-on-bound-value.tb examples/anneau-1/positive/tb-a1-p05-loop-explicit-item-call.tb examples/anneau-1/positive/tb-a1-p06-fallback-resolved-with-binding.tb examples/anneau-1/positive/tb-a1-p07-simple-agent-calls-no-enriched-dispatch.tb",
    "parse:anneau1-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/anneau-1/negative/semantic/tb-a1-n01-implicit-result-consumed-by-if.tb examples/anneau-1/negative/semantic/tb-a1-n02-missing-explicit-argument.tb examples/anneau-1/negative/semantic/tb-a1-n03-unknown-argument.tb examples/anneau-1/negative/semantic/tb-a1-n04-duplicate-argument.tb examples/anneau-1/negative/semantic/tb-a1-n05-duplicate-result-binding.tb examples/anneau-1/negative/semantic/tb-a1-n06-use-before-binding.tb examples/anneau-1/negative/semantic/tb-a1-n07-enriched-agent-call-blocked.tb examples/anneau-1/negative/semantic/tb-a1-n08-fallback-target-absent.tb",
    "parse:expressions-v1-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/expressions-v1/positive/tb-expr1-p01-int-arithmetic.tb examples/expressions-v1/positive/tb-expr1-p02-float-average.tb examples/expressions-v1/positive/tb-expr1-p03-boolean-comparison.tb examples/expressions-v1/positive/tb-expr1-p04-text-concat.tb examples/expressions-v1/positive/tb-expr1-p05-field-access.tb examples/expressions-v1/positive/tb-expr1-p06-call-argument-expression.tb examples/expressions-v1/positive/tb-expr1-p07-conditional-field-score.tb examples/expressions-v1/positive/tb-expr1-p08-text-rendering.tb",
    "parse:expressions-v1-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/expressions-v1/negative/semantic/tb-expr1-n01-text-plus.tb examples/expressions-v1/negative/semantic/tb-expr1-n02-unknown-field.tb examples/expressions-v1/negative/semantic/tb-expr1-n03-static-division-zero.tb examples/expressions-v1/negative/semantic/tb-expr1-n04-invalid-modulo-float.tb examples/expressions-v1/negative/semantic/tb-expr1-n05-text-order-comparison.tb examples/expressions-v1/negative/semantic/tb-expr1-n06-implicit-text-conversion.tb examples/expressions-v1/negative/semantic/tb-expr1-n09-text-render-local-type.tb",
    "parse:human-approval-v1-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/human-approval-v1/positive/tb-human-v1-p01-required-approval.tb examples/human-approval-v1/positive/tb-human-v1-p02-agent-review-branch.tb examples/human-approval-v1/positive/tb-human-v1-p03-strategy-approval.tb",
    "parse:human-approval-v1-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/human-approval-v1/negative/semantic/tb-human-v1-n01-missing-context.tb examples/human-approval-v1/negative/semantic/tb-human-v1-n02-missing-into.tb examples/human-approval-v1/negative/semantic/tb-human-v1-n03-unknown-argument.tb examples/human-approval-v1/negative/semantic/tb-human-v1-n04-function-approval.tb",
    "parse:user-interaction-v1-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/user-interaction-v1/positive/tb-user-v1-p01-show-ask.tb examples/user-interaction-v1/positive/tb-user-v1-p02-show-text-rendering.tb",
    "parse:user-interaction-v1-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/user-interaction-v1/negative/semantic/tb-user-v1-n01-ask-missing-into.tb examples/user-interaction-v1/negative/semantic/tb-user-v1-n02-show-in-function.tb examples/user-interaction-v1/negative/semantic/tb-user-v1-n03-show-unknown-argument.tb examples/user-interaction-v1/negative/semantic/tb-user-v1-n04-ask-non-text-prompt.tb",
    "parse:typechecker-v1-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/typechecker-v1/positive/tb-typecheck-v1-p01-int-to-float-give.tb examples/typechecker-v1/positive/tb-typecheck-v1-p02-field-argument.tb",
    "parse:typechecker-v1-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/typechecker-v1/negative/semantic/tb-typecheck-v1-n01-give-int-to-text.tb examples/typechecker-v1/negative/semantic/tb-typecheck-v1-n02-with-text-to-int.tb examples/typechecker-v1/negative/semantic/tb-typecheck-v1-n03-if-text-condition.tb examples/typechecker-v1/negative/semantic/tb-typecheck-v1-n04-for-non-list.tb examples/typechecker-v1/negative/semantic/tb-typecheck-v1-n05-unknown-field.tb",
    "parse:control-flow-v1-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/control-flow-v1/positive/tb-controlflow-v1-p01-if-branches-give.tb",
    "parse:control-flow-v1-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/control-flow-v1/negative/semantic/tb-controlflow-v1-n01-give-then-give.tb examples/control-flow-v1/negative/semantic/tb-controlflow-v1-n02-stop-then-show.tb examples/control-flow-v1/negative/semantic/tb-controlflow-v1-n03-if-terminal-then-show.tb",
    "parse:agent-authority-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/agent-authority-anneau-2/positive/tb-a2-auth-p01-strategy-callable-by.tb",
    "parse:agent-authority-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/agent-authority-anneau-2/negative/semantic/tb-a2-auth-n01-missing-callable-by.tb examples/agent-authority-anneau-2/negative/semantic/tb-a2-auth-n02-strategy-not-authorized.tb examples/agent-authority-anneau-2/negative/semantic/tb-a2-auth-n03-unknown-caller.tb examples/agent-authority-anneau-2/negative/semantic/tb-a2-auth-n04-invalid-caller-kind-skill.tb examples/agent-authority-anneau-2/negative/semantic/tb-a2-auth-n05-duplicate-caller.tb",
    "parse:memory-scopes-positive": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/memory-scopes-anneau-2/positive/tb-a2-mem-p01-agent-read-memory.tb examples/memory-scopes-anneau-2/positive/tb-a2-mem-p02-agent-write-memory.tb examples/memory-scopes-anneau-2/positive/tb-a2-mem-p03-skill-read-memory.tb examples/memory-scopes-anneau-2/positive/tb-a2-mem-p04-strategy-read-memory.tb",
    "parse:memory-scopes-negative-semantic": "tree-sitter parse --config-path ./tree-sitter-cli.config.json -p . -q examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n01-owner-unknown-memory.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n02-tool-unknown-memory.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n03-invalid-access.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n04-duplicate-memory.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n05-duplicate-owner-scope.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n06-duplicate-tool-access.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n07-missing-memory-read-capability.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n08-missing-memory-write-capability.tb examples/memory-scopes-anneau-2/negative/semantic/tb-a2-mem-n09-owner-scope-missing.tb",
    "test": "node ../../tools/validate-tree-sitter-corpus.mjs"
  }
}
