module examples.scenario_change_review_unauthorized

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
            with request as request
            into result
        give result

agent Engineer
    responsibility "Fulfill the declared Engineer responsibility using only authorized capabilities."
    uses MakeChange
    callable_by strategy AdminRun

strategy AdminRun
    uses Engineer
    do
        show
            with message as "Administrative review"

strategy RunChangeReview
    takes request as ChangeRequest
    uses Engineer
    do
        Engineer
