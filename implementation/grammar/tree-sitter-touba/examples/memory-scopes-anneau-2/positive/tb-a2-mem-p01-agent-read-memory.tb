module examples.a2_memory_agent_read

memory ProjectKnowledge

type Query
    text is Text

type KnowledgeResult
    summary is Text

tool ReadProjectKnowledge
    uses memory ProjectKnowledge read
    takes query as Query
    gives KnowledgeResult
    requires memory_read

skill UseProjectKnowledge
    description "Read project knowledge within the declared scope."
    takes query as Query
    gives KnowledgeResult
    uses ReadProjectKnowledge
    memory ProjectKnowledge read
    do
        ReadProjectKnowledge
            with query as query
            into result
        give result

agent Researcher
    takes query as Query
    gives KnowledgeResult
    responsibility "Fulfill the declared Researcher responsibility using only authorized capabilities."
    uses UseProjectKnowledge
    memory ProjectKnowledge read
    callable_by strategy RunResearch

strategy RunResearch
    takes query as Query
    gives KnowledgeResult
    uses Researcher
    do
        Researcher
            with query as query
            into result
        give result
