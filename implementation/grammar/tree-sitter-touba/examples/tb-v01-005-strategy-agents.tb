module examples.strategy_agents

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
            with request as request
            into change
        give change

skill ReviewChange
    takes change as ReviewedChange
    gives ReviewedChange
    do
        give change

agent Engineer
    responsibility "Apply the requested change and return the recorded result."
    takes request as ChangeRequest
    gives ReviewedChange
    uses MakeChange
    callable_by strategy RunChange

agent Reviewer
    responsibility "Review the recorded change supplied by the caller."
    takes change as ReviewedChange
    gives ReviewedChange
    uses ReviewChange
    callable_by strategy RunChange

strategy RunChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses Engineer
    uses Reviewer
    do
        Engineer
            with request as request
            into change
        Reviewer
            with change as change
            into reviewed
        give reviewed
