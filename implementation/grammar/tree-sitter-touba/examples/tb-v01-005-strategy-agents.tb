module examples.strategy_agents

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
        give ReviewedChange

skill ReviewChange
    takes change as ReviewedChange
    gives ReviewedChange
    do
        give ReviewedChange

agent Engineer
    responsibility "Fulfill the declared Engineer responsibility using only authorized capabilities."
    uses MakeChange
    callable_by strategy RunChange

agent Reviewer
    responsibility "Fulfill the declared Reviewer responsibility using only authorized capabilities."
    uses ReviewChange
    callable_by strategy RunChange

strategy RunChange
    uses Engineer
    uses Reviewer
    do
        Engineer
        Reviewer
        give ReviewedChange
