module list_transformations

function Positive
    takes values as List of Int
    gives List of Int
    do
        give [value * 2 for value in values if value > 0]

function Messages
    takes values as List of Int
    gives Text
    do
        give join([text(value) for value in values if value > 0], "; ")

function Nested
    takes value as Int
    gives List of List of Int
    do
        bind transformed as List of List of Int = [[value * 2 for value in [value, value + 1]] for value in [1, 2]]
        give concat(transformed, [[value]])

function Empty
    gives List of List of Int
    do
        give [[] for value in [1, 2]]

function Combine
    gives List of Int
    do
        bind first as List of Int = concat([], [1, 2])
        give concat(first, [3])

function FilterBeforeMap
    gives List of Int
    do
        give [12 // value for value in [0, 3, 4] if value != 0]
