module examples.linear_skill

type SourceRequest
    topic is Text

type SourceText
    content is Text

type SourceNote
    summary is Text

tool FetchSource
    takes request as SourceRequest
    gives SourceText

skill BuildNote
    takes request as SourceRequest
    gives SourceNote
    uses FetchSource
    do
        FetchSource
            with request as request
            into source
        give record SourceNote { summary as source.content }

agent Researcher
    responsibility "Build a note from the source requested by the caller."
    takes request as SourceRequest
    gives SourceNote
    uses BuildNote
    callable_by strategy RunSourcedNote

strategy RunSourcedNote
    takes request as SourceRequest
    gives SourceNote
    uses Researcher
    do
        Researcher
            with request as request
            into note
        give note
