module examples.human_required_approval

type Change
    summary is Text

type ApprovalDecision
    decision is Text

tool ApplyChange
    takes change as Change
    gives ApprovalDecision

skill ReviewAndApply
    takes change as Change
    gives ApprovalDecision
    uses ApplyChange
    do
        human.approve
            with context as change
            into approval

        ApplyChange
            with change as change
            into applied

        give applied
