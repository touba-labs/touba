module examples.a1_simple_agents

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
            with request as request
            into change
        give change

skill ReviewChange
    takes change as ReviewedChange
    gives ReviewedChange
    do
        give change

agent Engineer
    takes request as ChangeRequest
    gives ReviewedChange
    responsibility "Apply the requested change."
    uses MakeChange
    callable_by strategy RunChange

agent Reviewer
    takes change as ReviewedChange
    gives ReviewedChange
    responsibility "Review the supplied change."
    uses ReviewChange
    callable_by strategy RunChange

strategy RunChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses Engineer
    uses Reviewer
    do
        Engineer
            with request as request
            into change
        Reviewer
            with change as change
            into reviewed
        give reviewed
