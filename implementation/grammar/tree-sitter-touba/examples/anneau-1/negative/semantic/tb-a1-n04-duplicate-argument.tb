module examples.a1_negative_duplicate_argument

type SourceRequest
    query is Text

type SourceText
    body is Text

tool FetchSource
    takes request as SourceRequest
    gives SourceText

skill BrokenFlow
    takes request as SourceRequest
    gives SourceText
    uses FetchSource
    do
        FetchSource
            with request as request
            with request as request
            into source
        give source
