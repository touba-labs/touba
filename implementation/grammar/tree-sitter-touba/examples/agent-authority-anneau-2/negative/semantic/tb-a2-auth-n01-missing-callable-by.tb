module examples.a2_auth_missing_callable_by

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
            with request as request
            into result
        give result

agent Engineer
    responsibility "Fulfill the declared Engineer responsibility using only authorized capabilities."
    uses MakeChange

strategy RunChange
    uses Engineer
    do
        Engineer
