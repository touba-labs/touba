module examples.a2_auth_strategy_not_authorized

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
        give ReviewedChange

agent Engineer
    responsibility "Fulfill the declared Engineer responsibility using only authorized capabilities."
    uses MakeChange
    callable_by strategy AdminRun

strategy AdminRun
    uses Engineer
    do
        give ReviewedChange

strategy RunChange
    uses Engineer
    do
        Engineer
        give ReviewedChange
