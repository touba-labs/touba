module examples.a2_auth_strategy_allowed

type ChangeRequest
    summary is Text

type ReviewedChange
    summary is Text

tool ApplyChange
    takes request as ChangeRequest
    gives ReviewedChange

skill MakeChange
    description "Apply the authorized change and return its actual result."
    takes request as ChangeRequest
    gives ReviewedChange
    uses ApplyChange
    do
        ApplyChange
            with request as request
            into result
        give result

agent Engineer
    takes request as ChangeRequest
    gives ReviewedChange
    responsibility "Fulfill the declared Engineer responsibility using only authorized capabilities."
    uses MakeChange
    callable_by strategy RunChange

strategy RunChange
    takes request as ChangeRequest
    gives ReviewedChange
    uses Engineer
    do
        Engineer
            with request as request
            into result
        give result
