module examples.a2_trigger_schedule_define

define ResearchTopic as Text = "AI safety"

strategy RunResearch
    takes topic as Text
    gives Text
    do
        give topic

trigger DailyResearch
    on schedule "0 8 * * *"
    runs strategy RunResearch
    with topic as ResearchTopic
    limits
        max_runs_per_day as 1
        timeout_ms as 30000
