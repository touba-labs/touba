module examples.fallback

type SourceRequest
    topic is Text

type SourceText
    content is Text

tool FetchPrimarySource
    takes request as SourceRequest
    gives SourceText

skill BuildFallbackSource
    takes request as SourceRequest
    gives SourceText
    do
        stop

skill BuildSource
    takes request as SourceRequest
    gives SourceText
    uses FetchPrimarySource
    uses BuildFallbackSource
    do
        FetchPrimarySource
            with request as request
            into source
        give source
    on failure handler
        fallback BuildFallbackSource

agent Researcher
    takes request as SourceRequest
    gives SourceText
    responsibility "Retrieve the requested source, using the fallback if the primary source is unavailable."
    uses BuildSource
    callable_by strategy RunSourceLookup

strategy RunSourceLookup
    takes request as SourceRequest
    gives SourceText
    uses Researcher
    do
        Researcher
            with request as request
            into source
        give source
