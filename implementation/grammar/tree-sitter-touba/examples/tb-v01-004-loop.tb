module examples.loop

type NormalizedItems
    items are List of Text

function NormalizeItem
    takes item as Text
    gives Text
    do
        give item

skill NormalizeItems
    takes items as List of Text
    gives NormalizedItems
    uses NormalizeItem
    do
        for item in items
            NormalizeItem
                with item as item
        give record NormalizedItems { items as items }

agent Normalizer
    takes items as List of Text
    gives NormalizedItems
    responsibility "Process each supplied text item and return the collection."
    uses NormalizeItems
    callable_by strategy RunNormalization

strategy RunNormalization
    takes items as List of Text
    gives NormalizedItems
    uses Normalizer
    do
        Normalizer
            with items as items
            into normalized
        give normalized
